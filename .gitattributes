# 行尾统一：仓库内一律存 LF
* text=auto eol=lf

# Windows 脚本必须保持 CRLF —— cmd.exe 和 Windows Script Host 只认 CRLF，
# 行尾被转成 LF 时双击会直接报错（这是真会踩的坑，别删这几行）
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf
*.ps1 text eol=crlf
*.pyw text eol=crlf

# 二进制：不做任何行尾 / 编码转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.bmp  binary
*.mp3  binary
*.wav  binary
*.mp4  binary
*.zip  binary
*.exe  binary
*.ttf  binary
*.woff binary
*.woff2 binary

# 文档 / 配置
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.html text eol=lf
*.py   text eol=lf

# 让 git 的 diff 认得这是自动生成 / 数据文件
*.json  linguist-language=JSON
